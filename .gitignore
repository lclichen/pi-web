# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# pi-web runtime data (session metas, mode stub homes)
/.e2e-data/
/data/

# generated monaco assets (scripts/copy-monaco.mjs)
/public/monaco

# next.js
/.next/
/out/

# production
/build

# offline distribution artifacts (scripts/package-linux.sh)
/dist

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.factory
e2e_*.mjs
