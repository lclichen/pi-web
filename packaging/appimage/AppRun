#!/usr/bin/env bash
#
# AppRun — Amedac.ai AppImage 入口。
#
# 双击 / 命令行直接运行：确保服务已启动（幂等），然后打开浏览器。
#   ./Amedac.ai_*.AppImage            启动（已在运行则只开浏览器）
#   ./Amedac.ai_*.AppImage --no-open  启动但不开浏览器
#   ./Amedac.ai_*.AppImage status     服务状态
#   ./Amedac.ai_*.AppImage stop       停止全部服务
#   ./Amedac.ai_*.AppImage logs       跟踪日志
#
# 运行布局（AppImage 本体是只读挂载，可写内容全部落在本地目录）:
#   AMEDAC_HOME 默认 ~/.local/share/amedac
#   ├── app/      展开的完整分发包（升级时自动重展开，保留配置与数据）
#   ├── data/     沙盒平台数据库、WebUI 数据、容器 overlay
#   └── first-run 完成标记
set -uo pipefail

# ---- 解析真实路径（AppImage 环境下 APPDIR 由运行时注入）----
APPDIR="${APPDIR:-}"
if [ -z "$APPDIR" ]; then
  SOURCE="${BASH_SOURCE[0]}"
  while [ -L "$SOURCE" ]; do
    T="$(readlink "$SOURCE")"
    case "$T" in /*) SOURCE="$T" ;; *) SOURCE="$(dirname "$SOURCE")/$T" ;; esac
  done
  APPDIR="$(cd "$(dirname "$SOURCE")" && pwd)"
fi
PAYLOAD="$APPDIR/usr/share/amedac"
[ -d "$PAYLOAD/scripts" ] || { echo "ERROR: 包结构异常（缺少 $PAYLOAD）" >&2; exit 1; }

AMEDAC_HOME="${AMEDAC_HOME:-${XDG_DATA_HOME:-$HOME/.local/share}/amedac}"
CURRENT="$AMEDAC_HOME/app"
DATA_DIR="$AMEDAC_HOME/data"
mkdir -p "$AMEDAC_HOME"

BUNDLED_VERSION="$(cat "$PAYLOAD/VERSION.txt" 2>/dev/null || echo unknown)"

log()  { printf '\033[1;32m[amedac]\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m[amedac]\033[0m %s\n' "$*"; }

# ---- 无 FUSE 环境兜底提示 ----------
if [ ! -w "$AMEDAC_HOME" ]; then
  warn "无法写入 $AMEDAC_HOME —— 请用 AMEDAC_HOME=/可写路径 重新运行"
  exit 1
fi

# ---- 展开分发包（版本变化时重展开；保留用户配置与数据）----
needs_extract=1
if [ -f "$CURRENT/VERSION.txt" ] && [ -f "$CURRENT/.extracted-ok" ]; then
  [ "$(cat "$CURRENT/VERSION.txt")" = "$BUNDLED_VERSION" ] && needs_extract=0
fi
if [ "$needs_extract" = "1" ]; then
  if [ -d "$CURRENT" ]; then
    log "检测到新版本 ($BUNDLED_VERSION)，更新 $CURRENT …"
    # 用户改过的 env 先搬到暂存区，展开后还原
    STAGE="$AMEDAC_HOME/.cfg-stage"
    rm -rf "$STAGE"; mkdir -p "$STAGE"
    for f in platform.env piweb.env admin-password.txt; do
      [ -f "$CURRENT/sandbox/$f" ] && cp -a "$CURRENT/sandbox/$f" "$STAGE/"
    done
    chmod -R u+w "$CURRENT" 2>/dev/null || true
    rm -rf "$CURRENT"
  fi
  mkdir -p "$(dirname "$CURRENT")"
  log "首次安装：解压到 $CURRENT（约 ${AMEDAC_EXTRACT_NOTE:-300MB}，稍等片刻）…"
  cp -a "$PAYLOAD" "$CURRENT" || { warn "解压失败"; exit 1; }
  touch "$CURRENT/.extracted-ok"
  if [ -n "${STAGE:-}" ] && [ -d "$STAGE" ]; then
    mkdir -p "$CURRENT/sandbox"
    for f in "$STAGE"/*; do
      [ -e "$f" ] || continue
      name="$(basename "$f")"
      # 新包自带同名文件（如新模板）时以用户旧配置优先
      cp -a "$f" "$CURRENT/sandbox/$name"
    done
    rm -rf "$STAGE"
    log "已还原用户配置 sandbox/{platform.env,piweb.env,admin-password.txt}"
  fi
fi

# ---- 命令分发 ----------
CMD="${1:-start}"
case "$CMD" in
  stop)
    export DATA_DIR PLATFORM_PORT WEB_PORT
    exec bash "$CURRENT/scripts/stop-all.sh"
    ;;
  status)
    export DATA_DIR PLATFORM_PORT WEB_PORT
    exec bash "$CURRENT/scripts/status-all.sh"
    ;;
esac

# ---- 启动服务（start-all.sh 幂等）----------
export DATA_DIR
export PLATFORM_PORT="${PLATFORM_PORT:-3000}"
export WEB_PORT="${WEB_PORT:-30141}"

OPEN_BROWSER=1
[ "${1:-}" = "--no-open" ] && OPEN_BROWSER=0

bash "$CURRENT/scripts/start-all.sh"
RC=$?

# start-all 在端口被占时会失败退出——对双击场景给出更友好的指引
if [ $RC -ne 0 ]; then
  warn "启动未完成：常见原因是端口被占用（换端口见 logs/ 或设 PLATFORM_PORT/WEB_PORT）。"
fi

if [ "$OPEN_BROWSER" = "1" ]; then
  URL="http://127.0.0.1:$WEB_PORT/"
  if command -v xdg-open >/dev/null 2>&1; then
    setsid xdg-open "$URL" >/dev/null 2>&1 || true
  elif command -v open >/dev/null 2>&1; then
    setsid open "$URL" >/dev/null 2>&1 || true
  else
    log "浏览器访问 $URL"
  fi
fi

# 双击启动时保持一个终端窗口不自动关，用户能看到状态输出；命令行运行则直接结束
exit $RC
